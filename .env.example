# tenant-ec2: the names of the environment of the host. This file is the source of truth for the names.
# On the development machine, copy it to `.env`, set the values and keep mode 0600 (docs/credentials.md). A value lives in `.env` only, never in Git.
# That `.env` is the source of the Secrets Manager secret of the host: the `secret` command of the deploy script reads it.
# The secret holds the same names. The host renders its own `.env` from the secret.
# Each name starts with `EC2_`: Compose prefers the shell environment over `.env`, and a
# host shell can hold other values under the kit variable names.
#
# The file has three parts. A marker line starts each part and each block of Part 3. A script finds
# a part and a block by its marker line, so do not change a marker line.
#   Part 1  Core names with empty values. Homelab needs each name. Mac needs selected services only.
#           Mac excludes the domain and OpenViking names. Clear those names when selecting macos.
#   Part 2  Settings. Each one has a portable default, or it is a host value and is empty.
#   Part 3  One block for each option, DNS provider and the macos variant.
#           A name with an empty value in the block `Option <name>` needs a value only when
#           `EC2_OPTIONS` holds `<name>`. A name in the block `DNS provider <name>` needs a
#           value only when `EC2_DNS_PROVIDER` is `<name>`. A block ends at the next marker
#           line or at the end of the file.
# A Compose file stops when a name that it reads has no value, so this file alone renders no
# file set. Each secret has its test in the Compose file of its service: a missing value of an
# option stops a start only when the option is on.
# The two web search names can be empty when search is off. EC2_ACME_EMAIL can be empty
# with the core edge.

# ===== Part 1: the names of the core =====
# Keep one comment line between two secret names. The publish check reads a name that
# follows a line such as `..._API_KEY=` or `..._PASSWORD=` as a value.

# The domain subtree of the host, in the form `ec2.example.com`. Each public name is at `<name>.` below it.
EC2_DOMAIN=

# The LiteLLM gateway: the master key and the salt key.
EC2_LITELLM_MASTER_KEY=
EC2_LITELLM_SALT_KEY=

# The LiteLLM gateway: the secret of its Postgres database.
EC2_LITELLM_POSTGRES_PASSWORD=

# The LiteLLM gateway: the secret of its UI login.
EC2_LITELLM_UI_PASSWORD=

# OpenViking: the root key of its API.
EC2_OPENVIKING_ROOT_API_KEY=

# OpenViking: its virtual key of the gateway, for the embedding and vision calls.
# The bootstrap makes the key at the first boot. It is empty until then.
EC2_OPENVIKING_LITELLM_API_KEY=

# The pi-durable agent: the bearer that a client sends.
EC2_PI_DURABLE_API_KEY=

# The pi-durable agent: its virtual key of the gateway, for the model calls.
# The bootstrap makes the key at the first boot. It is empty until then.
EC2_PI_DURABLE_LITELLM_API_KEY=

# The pi-durable agent: its user key of OpenViking, for its memory calls. It is not the root key.
# OpenViking makes the key: the bootstrap makes one account for the agent through the admin API
# of OpenViking, after the first start of OpenViking, and saves the key here. It is empty until then.
EC2_PI_DURABLE_OPENVIKING_API_KEY=

# The snapshot repository: the read-only secret for the clone at the first boot. It stays empty for a public repository.
EC2_SNAPSHOT_CLONE_TOKEN=

# The gate of OpenKnowledge (docs/entra.md): the id of the Entra tenant, as 32 hexadecimal digits in five groups. It is not a secret.
EC2_OK_ENTRA_TENANT_ID=

# The gate of OpenKnowledge: the object id of the one Entra security group. Only a member of this group passes the gate. It is not a secret.
EC2_OK_ENTRA_GROUP_ID=

# The gate of OpenKnowledge: the application (client) id of its app registration. It is not a secret.
EC2_OK_OIDC_CLIENT_ID=

# The gate of OpenKnowledge: the client secret of that app registration. It has an end date: renew it before that date.
EC2_OK_OIDC_CLIENT_SECRET=

# The gate of OpenKnowledge: the key of its session cookie, 32 random bytes in URL-safe base64. `scripts/entra-app.sh secrets` makes it.
EC2_OK_COOKIE_SECRET=

# ===== Part 2: settings =====

# homelab is the existing Linux stack. macos uses separate stacks, secrets and private state.
# For macos, clear EC2_EDGE_NAMES, all OpenViking names and EC2_PANGOLIN_SITE.
# Leave EC2_OPTIONS empty and EC2_DNS_PROVIDER at manual. DNS is unavailable on macos.
EC2_VARIANT=homelab

# The Compose project, the time zone and the user name of the gateway UI.
COMPOSE_PROJECT_NAME=tenant-ec2
EC2_TZ=Etc/UTC
EC2_LITELLM_UI_USERNAME=admin

# The options of the kit: a list of option names with commas and no blank. The known names are
# `pangolin` and `copilot`. The default is empty: the core only. A script stops on a name that it
# does not know. Part 3 holds the names of each option.
EC2_OPTIONS=
# The DNS provider of the `dns` command: `manual`, `porkbun`, `route53` or `cloudflare`.
# `manual` changes nothing: it prints each record that the installer sets by hand. With the option
# `pangolin`, it is also the provider of the DNS-01 certificate: `porkbun` or `cloudflare`.
EC2_DNS_PROVIDER=manual
# The public names of the edge: a list with commas and no blank. The known names are `ok`
# (OpenKnowledge behind its gate), `agent`, `llm` and `ov`. Each name is at `<name>.` below
# `EC2_DOMAIN`. The edge makes a route for each name of the list and for no other name.
# Each name but `ok` answers only the range of `EC2_ADMIN_CIDR` on the core edge.
EC2_EDGE_NAMES=ok
# Not in this file: `COMPOSE_FILE`. The bootstrap writes it into the environment file of the host
# from `EC2_OPTIONS`. Compose reads it there, so a Compose command by hand uses the same files:
#   empty              compose.yaml:compose.caddy.yaml
#   copilot            compose.yaml:compose.caddy.yaml:compose.copilot.yaml
#   pangolin           compose.yaml:compose.pangolin.yaml
#   pangolin,copilot   compose.yaml:compose.pangolin.yaml:compose.copilot.yaml

# AWS: the region, the stack of the host, the image parameter of `new-image`, the instance type, the Bedrock
# inference profile of GPT-6 Luna and the Bedrock embedding model.
EC2_AWS_REGION=us-east-1
EC2_STACK_NAME=tenant-ec2-host
EC2_AMI_SSM_PARAMETER=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64
EC2_INSTANCE_TYPE=t3a.large
EC2_BEDROCK_LUNA_MODEL=us.openai.gpt-6-luna
EC2_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# The deploy script (`scripts/aws-host.sh deploy`): the other parameters of the host template. A name with no value is a host value.
# The template also reads `EC2_DOMAIN` and `EC2_ADMIN_CIDR`.
# The pinned image id of the host (`ami-<hexadecimal digits>`, the template parameter `AmiId`). `deploy` refuses an empty value.
# Fill it with `scripts/aws-host.sh current-image --write` (the image of the running instance: an update replaces nothing)
# or `scripts/aws-host.sh new-image --write` (the newest image of `EC2_AMI_SSM_PARAMETER`: the next deploy replaces the instance in two steps).
EC2_AMI_ID=
# The private IPv4 range of the VPC, in the form `<address>/<prefix length>`. The prefix length is from 16 to 26. Do not change it after the first deploy. Keep it outside 198.18.0.0/15: `compose.yaml` uses a part of that range for the network `egress`.
EC2_VPC_CIDR=
# The portable snapshot that the host clones: the HTTPS clone URL with no credential in it, the tag, and the commit of the tag as 40 hexadecimal digits.
EC2_SNAPSHOT_REPOSITORY=
EC2_SNAPSHOT_TAG=
EC2_SNAPSHOT_COMMIT=
# The path of the file with the public key of the new key pair of the host. The deploy script reads the key from the file.
EC2_SSH_PUBLIC_KEY_FILE=
# The size of the data volume in GiB.
EC2_DATA_VOLUME_SIZE=50
# The two switches of the template. Keep each at `false` until the provisioner has the rights for it (docs/reference/host-template.md, "Operations").
EC2_ENABLE_BUCKET=false
EC2_ENABLE_OPERATIONS=false
# The billing alarm: its address and its limit in USD. The address is necessary with `EC2_ENABLE_OPERATIONS=true`.
EC2_ALARM_EMAIL=
EC2_ALARM_THRESHOLD=100

# The outputs of the stack. `scripts/aws-host.sh outputs --write` sets each value.
# The name of the private bucket. The stack has a bucket only with `EC2_ENABLE_BUCKET=true`.
EC2_BUCKET=
# The Elastic IP of the host. Only the option `pangolin` reads it: it is the public address of
# the host for each tunnel (`gerbil.base_endpoint`). A name that has an A record to the Elastic
# IP is also correct. With no value, `scripts/render-pangolin.sh` uses `pangolin.` below `EC2_DOMAIN`.
EC2_GERBIL_BASE_ENDPOINT=

# The edge: the one IPv4 range of the administrator, in the form `<address>/<prefix length>`.
# The prefix length is from 16 to 32. It is a host value, so it is empty here.
# - The template: only this range reaches SSH.
# - The core edge: only this range reaches each public name but `ok`.
# - The option `pangolin`: only this range reaches the dashboard and the API of Pangolin.
EC2_ADMIN_CIDR=

# The edge: the address for the certificate account. It is a host value, so it is empty here.
# The core edge works with no value. The option `pangolin` needs a value.
EC2_ACME_EMAIL=

# OpenViking: the gateway route of its embedding calls, the vector size of that model, and the
# gateway route of its vision calls. The vector size is fixed after the first start: OpenViking
# refuses another size for the data that it has.
# With the option `copilot`, the routes `copilot/embed` (1536) and `copilot/luna` are also correct.
EC2_OPENVIKING_EMBED_MODEL=bedrock/embed
EC2_OPENVIKING_EMBED_DIMENSION=1024
EC2_OPENVIKING_VLM_MODEL=bedrock/luna

# The agent: its gateway route and its reasoning effort. The effort is `xhigh` only (AGENTS.md).
# With the option `copilot`, the route `copilot/luna` is also correct.
EC2_PI_DURABLE_MODEL=bedrock/luna
EC2_PI_DURABLE_THINKING=xhigh

# The agent: its web search, `off` or `mcp`. With `off`, the agent has no web tool.
# With `mcp`, the agent calls an MCP server that the installer names below.
# It needs both values. The core needs no search service.
EC2_PI_DURABLE_WEB_SEARCH=off

# The agent: the address of the MCP server, in the form `http://<host>:<port>/mcp`.
# Only the web search `mcp` reads it. Keep the value empty with `off`.
EC2_PI_DURABLE_WEB_SEARCH_MCP_URL=

# The agent: the bearer of that MCP server. Keep the value empty with `off`.
EC2_PI_DURABLE_WEB_SEARCH_MCP_TOKEN=

# Optional: a private kit source. `EC2_KIT_SOURCE_<KIT>` is the Git URL of a kit clone with no
# credential in it, in place of `source_repo` of kits.lock. `EC2_KIT_TOKEN_<KIT>` is the
# read-only secret for that clone. `<KIT>` is the name of the kit in kits.lock in capital
# letters, with `_` in place of `-`.
#EC2_KIT_SOURCE_LITELLM=https://git.example.com/example-owner/litellm.git
#EC2_KIT_SOURCE_OPENVIKING=https://git.example.com/example-owner/openviking.git
#EC2_KIT_SOURCE_OPEN_KNOWLEDGE=https://git.example.com/example-owner/open-knowledge.git
#EC2_KIT_SOURCE_PI_DURABLE=https://git.example.com/example-owner/pi-durable.git
#EC2_KIT_TOKEN_PI_DURABLE=

# ===== Part 3: the names of the options =====
# Keep one comment line between two secret names, as in Part 1.

# ----- Variant macos -----
# Only macos reads this block. The public sample selects no person, PIN, host or AMI.
# Stack defaults are <project>-macos-host and <project>-macos-allocation.
EC2_MACOS_STACK_NAME=
EC2_MACOS_ALLOCATION_STACK_NAME=
EC2_MACOS_AVAILABILITY_ZONE=

# Review a supported major before resolving this public SSM parameter in an approved live flow.
# Store ami.imageId, parameter, region, architecture=arm64_mac, rootVolumeMinGiB and reviewedAt
# in .local/macos/<runtime-stack>.json. Deploy never resolves a latest image automatically.
EC2_MACOS_AMI_SSM_PARAMETER=
EC2_MACOS_ROOT_VOLUME_SIZE=100
EC2_MACOS_DATA_VOLUME_SIZE=150

# EC2_SSH_PUBLIC_KEY_FILE in Part 2 supplies SshPublicKey. No private key enters the stack.
# The reviewed provider is explicit. No provider fallback is permitted.
EC2_MACOS_PODMAN_PROVIDER=applehv
# These sizes feed PodmanCpus, PodmanMemoryMiB and PodmanDiskGiB in machine.json.
# Bounds: 1-8 CPUs, 1024-16384 MiB memory, and 20-1024 GiB disk. Capacity is not qualified.
EC2_MACOS_PODMAN_CPUS=4
EC2_MACOS_PODMAN_MEMORY_MIB=8192
EC2_MACOS_PODMAN_DISK_GIB=80

# Select an active actorId, not a PIN. The stage maps it to DeveloperPin and a lowercase account.
# The service agent is a different identity in the stage hostRoles entry.
EC2_MACOS_MEMORY_STAGE=
# Confirm the selected person's exact uppercase stage PIN. This is an identifier, not a password.
EC2_MACOS_DEVELOPER_PIN=
EC2_MACOS_PERSON=
EC2_MACOS_AGENT=
EC2_MACOS_PROPOSAL_PROJECT=

# Derive MemoryArn and MemoryBucket from .local/memory/<stage>.json.
# Optional repeated values must match that file.
EC2_MACOS_MEMORY_ID=
EC2_MACOS_MEMORY_ARN=
EC2_MACOS_MEMORY_BUCKET=

# The reviewed runtime lock owns installer and provider versions. No implicit latest version.
EC2_MACOS_RUNTIME_LOCK=

# Private official cost evidence is required before allocation. No price is assumed here.
EC2_MACOS_HOST_HOURLY_USD=
EC2_MACOS_PRICE_CURRENCY=USD
EC2_MACOS_PRICE_REGION=
EC2_MACOS_PRICE_SOURCE=
EC2_MACOS_PRICE_CHECKED_AT=
# Allocation records ownership and cost in .local/macos/<runtime-stack>.json with mode 0600.
# For release, set releaseHostId in that file to its exact hostId after operator review.
# Stop leaves the host allocated. Pending scrub pauses host billing; ordinary stopped time does not.

# ----- Option pangolin -----
# The Pangolin edge in place of the core edge: Pangolin, Gerbil and Traefik. Its wildcard
# certificate comes from a DNS-01 challenge through the DNS provider, so the option needs the
# provider `porkbun` or `cloudflare`. With `porkbun` the host holds the two names of the block
# `DNS provider porkbun`. With `cloudflare` it holds EC2_CLOUDFLARE_DNS01_TOKEN only.

# Pangolin: the server secret.
EC2_PANGOLIN_SERVER_SECRET=

# Pangolin: the API key for the apply of the blueprint. The installer makes it in the dashboard
# after the first setup of Pangolin. It is empty until then, and the bootstrap skips the apply.
EC2_PANGOLIN_API_KEY=

# Pangolin: the identifier of the organization that the installer makes at the first setup. The
# apply of the blueprint needs it. It is empty until then.
EC2_PANGOLIN_ORG=

# Pangolin: the identifier of the local site of the host. Each target of the blueprint is on this site.
EC2_PANGOLIN_SITE=ec2-local

# ----- Option copilot -----
# The service `copilot` and the gateway routes `copilot/luna` and `copilot/embed`, from one
# GitHub Copilot account.

# The `copilot` service of the gateway: its master key.
EC2_COPILOT_MASTER_KEY=

# ----- DNS provider porkbun -----
# A credential of a DNS provider stays on the development machine: the `secret` command does not
# write a name of a DNS provider block to the secret. The exceptions are this pair with the
# option `pangolin` and `EC2_DNS_PROVIDER=porkbun`, and EC2_CLOUDFLARE_DNS01_TOKEN with the
# option `pangolin` and `EC2_DNS_PROVIDER=cloudflare`: Traefik on the host reads it for the
# DNS-01 certificate.

# Porkbun: the first value of the key pair, for the DNS records.
EC2_PORKBUN_API_KEY=

# Porkbun: the second value of the same pair.
EC2_PORKBUN_SECRET_KEY=

# ----- DNS provider cloudflare -----
# Only with `EC2_DNS_PROVIDER=cloudflare`. Only `scripts/aws-host.sh dns` reads the first two names,
# on the development machine. They do not go into the secret of the host (docs/options/dns.md).
# One API token with the right to edit the DNS records of one zone.
EC2_CLOUDFLARE_API_TOKEN=
# The id of that zone: 32 hexadecimal digits. It is not a secret.
EC2_CLOUDFLARE_ZONE_ID=
# The host token of the Pangolin edge: only with the option `pangolin`. The `secret` command
# writes it to the secret of the host, and Traefik passes it to its DNS provider as
# CF_DNS_API_TOKEN and CF_ZONE_API_TOKEN for the DNS-01 certificate. Make a new token for the
# host: do not use the token of the `dns` command or a token of another deployment. Its
# permissions are Zone Read and DNS Edit, and its scope is the one zone of the apex domain.
EC2_CLOUDFLARE_DNS01_TOKEN=

# ----- DNS provider route53 -----
# Only with `EC2_DNS_PROVIDER=route53`. Only `scripts/aws-host.sh dns` reads the two names, on the
# development machine. They do not go into the secret of the host (docs/options/dns.md).
# The AWS CLI profile of the installer with the Route 53 rights. It is not the provisioner profile.
EC2_ROUTE53_PROFILE=
# The id of the hosted zone that holds `EC2_DOMAIN`.
EC2_ROUTE53_HOSTED_ZONE_ID=
