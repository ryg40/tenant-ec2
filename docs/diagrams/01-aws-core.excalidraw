      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Core opens no tunnel port. EnablePangolin adds UDP 51820 and 21820. EFS and EBS are separate services.",
      "originalText": "Core opens no tunnel port. EnablePangolin adds UDP 51820 and 21820. EFS and EBS are separate services.",
