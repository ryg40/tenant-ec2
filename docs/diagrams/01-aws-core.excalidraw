      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Gateway calls Bedrock through the internet route. EnableBucket adds scoped object access only after the policy update.",
      "originalText": "Gateway calls Bedrock through the internet route. EnableBucket adds scoped object access only after the policy update.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
