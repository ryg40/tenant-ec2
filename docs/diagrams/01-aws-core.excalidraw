      "updated": 1,
      "link": null,
      "locked": false,
      "text": "IAM: Provisioner creates bounded roles; InstanceRole permits the host to read its secret and invoke Bedrock.",
      "originalText": "IAM: Provisioner creates bounded roles; InstanceRole permits the host to read its secret and invoke Bedrock.",
      "fontSize": 17,
