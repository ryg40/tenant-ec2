      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ea503d892f34f0298079",
      "type": "text",
      "x": 14,
      "y": 1756,
      "width": 889,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#243342",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
