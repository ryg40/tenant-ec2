      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Docker requires four durable mounts and the metadata guard: the EBS data volume plus the three EFS access points.",
      "originalText": "Docker requires four durable mounts and the metadata guard: the EBS data volume plus the three EFS access points.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "813ea37e5c7cb6e3ef16",
      "type": "text",
      "x": 14,
      "y": 1788,
      "width": 920,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#243342",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 135522871,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "EnableOperations and EnableBucket are separate switches, both off by default. The administrator owns the snapshot role.",
      "originalText": "EnableOperations and EnableBucket are separate switches, both off by default. The administrator owns the snapshot role.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0230dfd73fea8e0191ca",
      "type": "text",
      "x": 14,
      "y": 1820,
      "width": 905,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#243342",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
