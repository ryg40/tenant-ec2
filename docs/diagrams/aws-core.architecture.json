  "cards": [
    {
      "dot": "amber",
      "title": "What costs money",
      "items": [
        "The EC2 instance, for each hour that it runs",
        "The EBS volume and the EFS files, for the stored size",
        "The public IPv4 address of the Elastic IP, for each hour",
        "Bedrock, for each model request through LiteLLM",
        "The Secrets Manager secret, for each month",
        "Options: the S3 bucket, daily snapshots, host logs and a billing alarm"
      ]
    },
    {
      "dot": "cyan",
      "title": "What is public",
      "items": [
        "Only ok.<domain>, on ports 80 and 443, by default",
        "OpenKnowledge asks for a Microsoft Entra sign-in and the group rule",
        "SSH answers only the AdminCidr address range"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where your data lives",
      "items": [
        "EBS: the local databases, Postgres of LiteLLM included",
        "EFS: the OpenKnowledge pages, the OpenViking data and the shared files",
        "Options: daily EBS snapshots and a private, encrypted S3 bucket"
      ]
    },
    {
      "dot": "rose",
      "title": "Sign-ins and keys",
      "items": [
        "You sign in to OpenKnowledge with Microsoft Entra ID",
        "The instance role gives the host its AWS access, so no AWS key is on the host",
        "The provisioner key stays on the administrator machine",
        "The host reads the stack secret at boot"
      ]
    },
    {
      "dot": "slate",
      "title": "Not verified",
      "items": [
        "A complete live install of this core with its Entra sign-in"
      ]
    }
  ]
