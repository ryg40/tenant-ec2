  "cards": [
    {
      "dot": "amber",
      "title": "What costs money",
      "items": [
        "The Dedicated Host, from allocation to release, with 24 billed hours at least",
        "Planning rate: USD 0.878 per hour for mac2-m2 in us-east-1; confirm it before each allocation",
        "The EBS volume, the two secrets and the public IPv4 address",
        "Bedrock, for each model request"
      ]
    },
    {
      "dot": "cyan",
      "title": "How you reach it",
      "items": [
        "Run scripts/aws-host.sh tunnel --apply on your computer and keep it open",
        "Open http://localhost:4180 and sign in with Microsoft Entra ID",
        "The Mac takes no inbound connection: the tunnel runs through Systems Manager"
      ]
    },
    {
      "dot": "orange",
      "title": "What runs",
      "items": [
        "Four services in a Podman machine: the gate, OpenKnowledge, LiteLLM and Postgres",
        "The agent stays off until a compatible kit release and pin",
        "No public edge, no OpenViking, no option and no public DNS"
      ]
    },
    {
      "dot": "rose",
      "title": "Sign-ins and keys",
      "items": [
        "One local administrator account, named by a PIN",
        "The containers get temporary instance-role credentials through the credential bridge",
        "No personal memory key on the Mac"
      ]
    },
    {
      "dot": "slate",
      "title": "Not verified",
      "items": [
        "The Mac runtime on the selected AMI: applehv, guest networking and the credential bridge",
        "A live install of the Mac variant"
      ]
    }
  ]
